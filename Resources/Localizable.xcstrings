    "Clipsody needs to restart to switch the language.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipsody muss neu starten, um die Sprache zu wechseln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipsody debe reiniciarse para cambiar el idioma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipsody doit redémarrer pour changer de langue."
          }
        },
        "it": {
          "stringUnit": {

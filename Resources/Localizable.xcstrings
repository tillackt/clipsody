    "Click into a field, then on the value (or ⌥⌘V for the next one), or drag the value into the field.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke in ein Feld, dann auf den Wert (oder ⌥⌘V für den nächsten) – oder ziehe den Wert ins Feld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en un campo y luego en el valor (o ⌥⌘V para el siguiente), o arrastra el valor al campo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez dans un champ, puis sur la valeur (ou ⌥⌘V pour la suivante), ou faites glisser la valeur dans le champ."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Clicca in un campo, poi sul valore (oppure ⌥⌘V per il successivo), o trascina il valore nel campo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik in een veld en dan op de waarde (of ⌥⌘V voor de volgende), of sleep de waarde naar het veld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",

    "Starts Clipsody when you log in to your Mac. Copied content is only added to the history while the app is running.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet Clipsody nach dem Anmelden am Mac. Nur solange die App läuft, wird kopierter Inhalt in die Historie aufgenommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Clipsody al iniciar sesión en tu Mac. El contenido copiado solo se añade al historial mientras la app está abierta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Clipsody lorsque vous vous connectez à votre Mac. Le contenu copié n’est ajouté à l’historique que lorsque l’app est ouverte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia Clipsody quando accedi al Mac. I contenuti copiati vengono aggiunti alla cronologia solo mentre l’app è in esecuzione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start Clipsody wanneer je inlogt op je Mac. Gekopieerde inhoud wordt alleen aan de geschiedenis toegevoegd zolang de app draait."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uruchamia Clipsody po zalogowaniu na Macu. Skopiowana treść trafia do historii tylko wtedy, gdy aplikacja działa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o Clipsody quando você inicia sessão no Mac. O conteúdo copiado só é adicionado ao histórico enquanto o app está aberto."
          }
        }
      }
    },

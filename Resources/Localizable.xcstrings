    "Clipsody cannot replace itself in this folder. Download the new version from the release page and drag it to Applications.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipsody kann sich in diesem Ordner nicht selbst ersetzen. Lade die neue Version von der Release-Seite und ziehe sie in den Programme-Ordner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipsody no puede reemplazarse a sí mismo en esta carpeta. Descarga la nueva versión desde la página de la versión y arrástrala a Aplicaciones."

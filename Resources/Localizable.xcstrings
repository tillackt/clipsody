    "By default Clipsody uses the language of your Mac. A change takes effect after Clipsody restarts.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig nutzt Clipsody die Sprache deines Macs. Eine Änderung wird nach dem Neustart von Clipsody wirksam."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por defecto, Clipsody usa el idioma de tu Mac. Un cambio se aplica después de reiniciar Clipsody."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par défaut, Clipsody utilise la langue de votre Mac. Une modification prend effet après le redémarrage de Clipsody."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per impostazione predefinita Clipsody usa la lingua del Mac. Una modifica ha effetto dopo il riavvio di Clipsody."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Standaard gebruikt Clipsody de taal van je Mac. Een wijziging gaat in nadat Clipsody opnieuw is gestart."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Domyślnie Clipsody używa języka Twojego Maca. Zmiana zacznie działać po ponownym uruchomieniu Clipsody."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por padrão, o Clipsody usa o idioma do seu Mac. Uma alteração entra em vigor depois que o Clipsody reiniciar."
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "de": {

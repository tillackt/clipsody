    "By default Clippboard uses the language of your Mac. A change takes effect after Clippboard restarts.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig nutzt Clippboard die Sprache deines Macs. Eine Änderung wirkt nach dem Neustart von Clippboard."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par défaut, Clippboard utilise la langue de votre Mac. Une modification prend effet après le redémarrage de Clippboard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por defecto, Clippboard usa el idioma de tu Mac. Un cambio se aplica después de reiniciar Clippboard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per impostazione predefinita Clippboard usa la lingua del Mac. Una modifica ha effetto dopo il riavvio di Clippboard."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Standaard gebruikt Clippboard de taal van je Mac. Een wijziging gaat in nadat Clippboard opnieuw is gestart."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Domyślnie Clippboard używa języka Twojego Maca. Zmiana zacznie działać po ponownym uruchomieniu Clippboard."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por padrão, o Clippboard usa o idioma do seu Mac. Uma alteração entra em vigor depois que o Clippboard reiniciar."
          }
        }
      }
    },

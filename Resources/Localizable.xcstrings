    "macOS rejected the hotkey %@ (%@). Please choose a combination with ⌘ or ⌃.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS hat den Hotkey %@ abgelehnt (%@). Bitte eine Kombination mit ⌘ oder ⌃ wählen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ha rechazado el atajo %@ (%@). Elige una combinación con ⌘ o ⌃."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS a refusé le raccourci %@ (%@). Choisissez une combinaison avec ⌘ ou ⌃."
          }
        },
        "it": {
          "stringUnit": {

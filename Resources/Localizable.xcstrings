    "Snippets are texts you paste often, or several fields to fill in a form.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Textbausteine sind Texte, die du oft einfügst, oder mehrere Felder zum Ausfüllen eines Formulars."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los fragmentos son textos que pegas a menudo o varios campos para rellenar un formulario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les extraits sont des textes que vous collez souvent, ou plusieurs champs pour remplir un formulaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I frammenti sono testi che incolli spesso, oppure più campi per compilare un modulo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekstfragmenten zijn teksten die je vaak plakt, of meerdere velden om een formulier in te vullen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragmenty tekstu to teksty, które często wklejasz, albo kilka pól do wypełnienia formularza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Trechos são textos que você cola com frequência ou vários campos para preencher um formulário."
          }
        }
      }
    },
    "Snippets could not be saved; changes may be lost.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Textbausteine konnten nicht gespeichert werden; Änderungen gehen womöglich verloren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han podido guardar los fragmentos; los cambios podrían perderse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les extraits n’ont pas pu être enregistrés ; des modifications pourraient être perdues."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile salvare i frammenti; le modifiche potrebbero andare perse."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",

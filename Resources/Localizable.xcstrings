    "Starts Clippboard when you log in to your Mac. Copied content is only added to the history while the app is running.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet Clippboard nach dem Anmelden am Mac. Nur solange die App läuft, wird kopierter Inhalt in die Historie aufgenommen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lance Clippboard à l’ouverture de session sur votre Mac. Le contenu copié n’est ajouté à l’historique que lorsque l’app est ouverte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Clippboard al iniciar sesión en tu Mac. El contenido copiado solo se añade al historial mientras la app está abierta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia Clippboard quando accedi al Mac. I contenuti copiati vengono aggiunti alla cronologia solo mentre l’app è in esecuzione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start Clippboard wanneer je inlogt op je Mac. Gekopieerde inhoud wordt alleen aan de geschiedenis toegevoegd zolang de app draait."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uruchamia Clippboard po zalogowaniu na Macu. Skopiowana treść trafia do historii tylko wtedy, gdy aplikacja działa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o Clippboard quando você inicia sessão no Mac. O conteúdo copiado só é adicionado ao histórico enquanto o app está aberto."
          }
        }
      }
    },
    "Text recognized": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Text erkannt"
          }
        },
        "fr": {

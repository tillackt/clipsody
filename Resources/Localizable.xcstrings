    "Add app": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App hinzufügen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir app"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter une app"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi app"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "App toevoegen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj aplikację"
          }
        },
        "pt-BR": {

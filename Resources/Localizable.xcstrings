    "No text field selected – nothing was pasted. Click into a field first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Eingabefeld ausgewählt – nichts eingefügt. Klicke zuerst in ein Feld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ningún campo de texto seleccionado; no se ha pegado nada. Haz clic primero en un campo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun champ de saisie sélectionné – rien n’a été collé. Cliquez d’abord dans un champ."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun campo di testo selezionato – non è stato incollato nulla. Clicca prima in un campo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen invoerveld geselecteerd – er is niets geplakt. Klik eerst in een veld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie wybrano pola tekstowego – nic nie wklejono. Najpierw kliknij w pole."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum campo de texto selecionado – nada foi colado. Clique primeiro em um campo."
          }
        }
      }
    },
    "Nothing pinned yet. Pin entries in the history with ⌘P.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts angepinnt. Pinne Einträge in der Historie mit ⌘P an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay nada fijado. Fija entradas del historial con ⌘P."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien d’épinglé pour l’instant. Épingle des entrées de l’historique avec ⌘P."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora niente di fissato. Fissa le voci della cronologia con ⌘P."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog niets vastgezet. Zet items in de geschiedenis vast met ⌘P."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic jeszcze nie przypięto. Przypnij wpisy z historii za pomocą ⌘P."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada fixado ainda. Fixe itens do histórico com ⌘P."
          }
        }
      }
    },
    "OK": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        },
        "es": {
          "stringUnit": {
